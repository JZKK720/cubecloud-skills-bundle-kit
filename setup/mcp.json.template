{
  "servers": {
    "microsoft/markitdown": {
      "type": "stdio",
      "command": "uvx",
      "args": ["markitdown-mcp@latest"],
      "gallery": "https://api.mcp.github.com",
      "version": "1.0.0"
    },
    "skillspector": {
      "type": "stdio",
      "command": "skillspector",
      "args": ["mcp"],
      "env": { "PYTHONUTF8": "1" }
    },
    "firecrawl": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "firecrawl-mcp@latest"],
      "env": {}
    },
    "scrapling": {
      "type": "stdio",
      "command": "scrapling",
      "args": ["mcp"],
      "env": { "PYTHONUTF8": "1" }
    },
    "gbrain": {
      "type": "stdio",
      "command": "gbrain",
      "args": ["serve"]
    },
    "graphify": {
      "type": "stdio",
      "command": "graphify-mcp",
      "args": ["--transport", "stdio"]
    },
    "headroom": {
      "type": "stdio",
      "command": "headroom",
      "args": ["mcp", "serve"],
      "env": { "PYTHONUTF8": "1" }
    },
    "loop-engineering": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@cobusgreyling/loop-mcp-server"],
      "env": {}
    },
    "watch-skill": {
      "type": "stdio",
      "command": "watch-skill",
      "args": ["serve"],
      "env": { "PYTHONUTF8": "1" }
    },
    "wigolo": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "wigolo"],
      "env": {}
    },
    "skillopt": {
      "type": "stdio",
      "command": "python",
      "args": ["${env:USERPROFILE}\\dev\\forks\\JZKK720\\SkillOpt\\plugins\\copilot\\skillopt\\mcp_server.py"],
      "env": {
        "SKILLOPT_REPO": "${env:USERPROFILE}\\dev\\forks\\JZKK720\\SkillOpt",
        "PYTHONUTF8": "1"
      }
    }
  },
  "inputs": []
}