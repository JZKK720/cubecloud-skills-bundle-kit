forks/

# Local runtime artifacts (created by the installer, not source).
# Governance docs in upstream/ ARE tracked (SCAN_LOG, audits) but
# transient logs from tools are not.
upstream/*.log

# skillevaluator writes tier1/json/html reports into the CWD when run without -o.
reports/

# OS noise
Thumbs.db
desktop.ini
.DS_Store

# Editor
.vscode/
*.code-workspace
# Tracked workspace tasks (verification entry points for agents)
!.vscode/tasks.json
